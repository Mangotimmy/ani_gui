{
  "name": "aniflix",
  "version": "2.7.1",
  "type": "module",
  "description": "Netflix-style GUI and Batch Downloader for ani-cli",
  "author": "AniFlix Team<aniflix@gmail.com>",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "sprintf-js": ">=1.1.3",
    "braces": ">=3.0.3",
    "micromatch": ">=4.0.8",
    "postcss-selector-parser": ">=7.1.6"
  },
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "verify:server": "node scripts/verify-fixes.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "desktop:start": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder --publish always",
    "docker:deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-docker.ps1",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "git:push-tag": "node scripts/release.mjs",
    "postversion": "git push && git push --tags"
  },
  "build": {
    "appId": "com.aniflix.desktop",
    "productName": "AniFlix",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "Mangotimmy",
      "repo": "ani_gui",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Video",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.54.0",
    "opencc-js": "^1.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "electron": "^33.4.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
