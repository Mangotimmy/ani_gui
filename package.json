{
  "name": "aniflix",
  "version": "2.0.2",
  "type": "module",
  "description": "Netflix-style GUI and Batch Downloader for ani-cli",
  "author": "AniFlix Team",
  "main": "electron/main.cjs",
  "overrides": {
    "tar": ">=7.5.21",
    "sprintf-js": "^1.1.3"
  },
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "desktop:start": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.aniflix.desktop",
    "productName": "AniFlix",
    "directories": {
      "output": "dist-electron"
    },
    "publish": {
      "provider": "github",
      "owner": "你的GitHub帳號或組織名",
      "repo": "你的Repository名稱",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Video",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.19.2",
    "hls.js": "^1.5.14",
    "lucide-react": "^0.395.0",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}
