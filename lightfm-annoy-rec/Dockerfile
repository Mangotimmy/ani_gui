# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# ani_gui LightFM + Annoy recommendation service
# Multi-stage build: lightfm/annoy are compiled in the builder stage, so the
# runtime image ships no compiler at all.
#
# Python 3.10 on purpose: lightfm 1.17 publishes no wheels and its sdist ships C
# generated by Cython 0.29, which no longer compiles against CPython 3.11+
# (tstate->curexc_traceback was removed). 3.10 is the newest interpreter it builds on.
# ---------------------------------------------------------------------------
FROM python:3.10-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential g++ \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Requirements first: this layer is cached until requirements.txt changes.
COPY requirements.txt ./
# lightfm's setup.py also breaks under setuptools >= 70, so it is pinned and build
# isolation is disabled (numpy/Cython/wheel must therefore be present up front).
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade 'pip<25' \
 && /opt/venv/bin/pip install 'setuptools==69.5.1' 'wheel==0.43.0' 'numpy==1.26.4' 'Cython<3' \
 && /opt/venv/bin/pip install --no-build-isolation -r requirements.txt \
 && /opt/venv/bin/python -c "import lightfm, annoy, fastapi; print('lightfm', lightfm.__version__)"

# ---------------------------------------------------------------------------
FROM python:3.10-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    REC_ARTIFACT_DIR=/app/data \
    REC_PLATFORM_DATA_DIR=/app/data \
    REC_PORT=8080 \
    REC_PREFETCH=0

# lightfm's extension is linked against the OpenMP runtime, which slim does not ship.
# Without libgomp1 the import silently degrades and every recommendation fails at runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

# Fail the build here rather than on the first request.
RUN python -c "import lightfm, annoy, fastapi, numpy; print('runtime lightfm', lightfm.__version__, '| numpy', numpy.__version__)"

WORKDIR /app
COPY src ./src
COPY tests ./tests

RUN mkdir -p /app/data \
 && useradd --create-home --uid 10001 rec \
 && chown -R rec:rec /app

USER rec
VOLUME ["/app/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=4).status == 200 else 1)"

# Single worker on purpose: one process keeps the mmap'd index shared and RAM predictable.
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
